<?xml version="1.0" encoding="UTF-8"?>
<openbox_menu xmlns="http://openbox.org/3.4/menu">
<menu id="root-menu" label="ArchBang">
  <item label="Terminal"><action name="Execute"><command>lxterminal</command></action></item>
  <item label="Run"><action name="Execute"><command>rofi -show drun</command></action></item>
  <item label="Web Browser"><action name="Execute"><command>firefox</command></action></item>
  <item label="File Manager"><action name="Execute"><command>thunar</command></action></item>
  <item label="Text Editor"><action name="Execute"><command>l3afpad</command></action></item>
  <separator />
  <menu id="sys-menu" label="System">
    <item label="GParted"><action name="Execute"><command>sudo -E gparted</command></action></item>
    <item label="Appearance"><action name="Execute"><command>lxappearance</command></action></item>
    <item label="Edit Menu"><action name="Execute"><command>l3afpad ~/.config/openbox/menu.xml</command></action></item>
    <item label="Edit Autostart"><action name="Execute"><command>l3afpad ~/.config/openbox/autostart</command></action></item>
    <item label="Reconfigure"><action name="Reconfigure" /></item>
  </menu>
  <separator />
  <item label="Lock"><action name="Execute"><command>slock</command></action></item>
  <item label="Log Out"><action name="Exit"><prompt>yes</prompt></action></item>
  <item label="Reboot"><action name="Execute"><command>systemctl reboot</command></action></item>
  <item label="Power Off"><action name="Execute"><command>systemctl poweroff</command></action></item>
</menu>
</openbox_menu>
